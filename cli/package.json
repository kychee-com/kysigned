{
  "name": "kysigned",
  "version": "0.1.0",
  "description": "Verify a kysigned evidence bundle on your own machine: npx kysigned verify <bundle.pdf>. No account, no upload, kysigned is not in the trust set.",
  "type": "module",
  "bin": {
    "kysigned": "dist/kysigned.mjs"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && node --test \"test/*.test.mjs\""
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "kysigned",
    "e-signature",
    "dkim",
    "verify",
    "evidence",
    "cli",
    "agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kychee-com/kysigned.git",
    "directory": "cli"
  },
  "homepage": "https://kysigned.com/verify",
  "license": "Apache-2.0"
}
